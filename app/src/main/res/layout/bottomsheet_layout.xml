<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/dialog_bkg">


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:layout_gravity="center|top"
        android:textSize="25sp"
        android:id="@+id/stationTitle"
        android:fontFamily="sans-serif-condensed"/>

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/m3_split_button_chevron_avd"
        android:layout_gravity="end"
        android:layout_marginTop="-26dp"
        android:scaleX="1.4"
        android:scaleY="1.4"
        android:id="@+id/cancelButton"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/outline_directions_bike_24"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:text="@string/current_amount"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium"
            android:padding="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewEnd"
            android:text=""
            android:textSize="25sp"
            android:padding="8dp"
            android:fontFamily="sans-serif-black"
            android:id="@+id/currentAmount"
            android:textColor="@color/accent"/>



    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/layoutDetails"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/outline_finance_24"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/prognose"
            android:textSize="20sp"
            android:layout_marginTop="3dp"
            android:padding="9dp"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewEnd"
            android:text=""
            android:textSize="25sp"
            android:padding="8dp"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/accent"
            android:id="@+id/trend"/>

    </LinearLayout>

    <TableLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:padding="13dp">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="1h"
                android:textSize="16sp"
                android:fontFamily="sans-serif-condensed-light"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="2h"
                android:textSize="16sp"
                android:fontFamily="sans-serif-condensed-light"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="3h"
                android:textSize="16sp"
                android:fontFamily="sans-serif-condensed-light"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="6h"
                android:textSize="16sp"
                android:fontFamily="sans-serif-condensed-light"/>
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="60dp"
                android:scaleX="100"/>
            <ImageView
                android:layout_width="60dp"
                android:scaleX="100"/>
            <ImageView
                android:layout_width="60dp"
                android:scaleX="100"/>
            <ImageView
                android:layout_width="60dp"
                android:scaleX="100"/>
        </TableRow>
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text=""
                android:textSize="18sp"
                android:fontFamily="sans-serif-condensed-medium"
                android:id="@+id/trend_one"
                android:textColor="@color/accent"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text=""
                android:textSize="18sp"
                android:fontFamily="sans-serif-condensed-medium"
                android:id="@+id/trend_two"
                android:textColor="@color/accent"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text=""
                android:textSize="18sp"
                android:fontFamily="sans-serif-condensed-medium"
                android:id="@+id/trend_three"
                android:textColor="@color/accent"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text=""
                android:textSize="18sp"
                android:fontFamily="sans-serif-condensed-medium"
                android:id="@+id/trendSix"
                android:textColor="@color/accent"/>
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text=""
                android:textSize="16sp"
                android:fontFamily="sans-serif-condensed-light"
                android:id="@+id/percentage_one"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text=""
                android:textSize="16sp"
                android:fontFamily="sans-serif-condensed-light"
                android:id="@+id/percentage_two"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text=""
                android:textSize="16sp"
                android:fontFamily="sans-serif-condensed-light"
                android:id="@+id/percentage_three"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text=""
                android:textSize="16sp"
                android:fontFamily="sans-serif-condensed-light"
                android:id="@+id/percentage_six"/>
        </TableRow>

    </TableLayout>


</LinearLayout>